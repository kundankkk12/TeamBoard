  "item": [
    {
      "name": "01 - Register New Company",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "var data = pm.response.json();",
              "pm.collectionVariables.set('access_token', data.access);",
              "pm.test('api_key exists', function () {",
              "  pm.expect(data.api_key).to.exist;",
              "});",
              "pm.test('access token exists', function () {",
              "  pm.expect(data.access).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"company_name\": \"{{company_name}}\",\n  \"email\": \"{{email}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register", ""]
        },
        "description": "Scenario 1: Register a new company. Expected 201 + api_key + JWT token."
      }
    },
